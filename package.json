{
  "name": "roadmiterefrontend",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext .ts,.tsx --max-warnings=0",
    "test": "jest",
    "test:watch": "jest --watch",
    "guardrails:frontend": "python scripts/check_frontend_guardrails.py",
    "data:sync:unibuc": "python scripts/sync_unibuc_real_data.py",
    "data:sync:manual": "python scripts/sync_manual_real_data.py",
    "assets:download": "python scripts/download_remote_assets.py",
    "qa:phase5": "python scripts/run_phase5_qa.py",
    "qa:phase5:real": "python scripts/run_phase5_qa.py --performance-metrics docs/perf/real_data_current.json"
  },
  "dependencies": {
    "@expo-google-fonts/pacifico": "^0.2.3",
    "@expo-google-fonts/plus-jakarta-sans": "^0.2.3",
    "@expo/vector-icons": "^15.0.3",
    "@shopify/flash-list": "^2.2.2",
    "expo": "^54.0.33",
    "expo-asset": "~12.0.12",
    "expo-constants": "~18.0.13",
    "expo-font": "~14.0.11",
    "expo-haptics": "~15.0.8",
    "expo-linking": "~8.0.11",
    "expo-router": "~6.0.23",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "expo-system-ui": "~6.0.9",
    "react": "19.1.0",
    "react-dom": "^19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-worklets": "0.5.1"
  },
  "devDependencies": {
    "@testing-library/jest-native": "^5.4.3",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.1.10",
    "eslint": "^8.57.1",
    "eslint-config-expo": "^9.2.0",
    "jest": "^29.7.0",
    "jest-expo": "^54.0.4",
    "react-test-renderer": "19.1.0",
    "typescript": "~5.9.2"
  }
}
